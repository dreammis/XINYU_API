{
  "openapi": "3.1.0",
  "info": {
    "title": "XY API Images",
    "version": "1.2.0",
    "description": "XY API public gateway contract. Product route names do not imply an original-provider connection."
  },
  "servers": [
    {
      "url": "https://openai.2yanx.dpdns.org"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Images"
    }
  ],
  "paths": {
    "/v1/images/generations": {
      "post": {
        "tags": [
          "Images"
        ],
        "operationId": "generateImage",
        "summary": "Generate an image",
        "x-title-zh": "生成图片",
        "description": "Generate one image. Prefer stream=true for long requests. See the image guide for model-specific quality and pixel limits.",
        "responses": {
          "200": {
            "description": "JSON result, or SSE comment heartbeats, optional progress events (progress=true), then a completion/error event. Only a completed event proves delivery.",
            "headers": {
              "X-Image-Request-Id": {
                "description": "Request ID for support; may differ from the final New API request_id.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageResult"
                },
                "example": {
                  "created": 1790980000,
                  "data": [
                    {
                      "url": "https://s3.yanxinyu.ggff.net/media_outputs/0123456789abcdef0123456789abcdef.png"
                    }
                  ]
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: image_url.completed\ndata: {\"type\":\"image_url.completed\",\"operation\":\"generate\",\"url\":\"https://s3.yanxinyu.ggff.net/media_outputs/0123456789abcdef0123456789abcdef.png\",\"request_id\":\"REQUEST_ID\",\"created_at\":1790980000}\n\ndata: [DONE]\n\n"
              }
            }
          },
          "400": {
            "description": "Unsupported or conflicting parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid customer API Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds upload limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity or rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Generation or image delivery failed; do not automatically resubmit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "507": {
            "description": "Insufficient capacity before submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageGenerationRequest"
              },
              "example": {
                "model": "gpt-image-2",
                "prompt": "白色背景上的黄色圆形，简洁插画",
                "resolution": "4k",
                "aspect_ratio": "16:9",
                "stream": true,
                "delivery": "url",
                "progress": true
              }
            }
          }
        },
        "x-description-zh": "生成一张图片。耗时请求建议开启 stream；各模型的质量与实际像素限制见图片指南。",
        "x-sse-events": [
          "#/components/schemas/ImageProgressEvent",
          "#/components/schemas/ImageCompletedEvent",
          "#/components/schemas/ImageURLCompletedEvent"
        ]
      }
    },
    "/v1/images/edits": {
      "post": {
        "tags": [
          "Images"
        ],
        "operationId": "editImage",
        "summary": "Edit an image",
        "x-title-zh": "编辑图片",
        "description": "Reference-image editing without masks. JSON image accepts one or more sources. Multipart uses image or repeated image[] files, each at most 20 MiB.",
        "responses": {
          "200": {
            "description": "JSON result, or SSE comment heartbeats, optional progress events (progress=true), then a completion/error event. Only a completed event proves delivery.",
            "headers": {
              "X-Image-Request-Id": {
                "description": "Request ID for support; may differ from the final New API request_id.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageResult"
                },
                "example": {
                  "created": 1790980000,
                  "data": [
                    {
                      "url": "https://s3.yanxinyu.ggff.net/media_outputs/0123456789abcdef0123456789abcdef.png"
                    }
                  ]
                }
              },
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "example": "event: image_url.completed\ndata: {\"type\":\"image_url.completed\",\"operation\":\"edit\",\"url\":\"https://s3.yanxinyu.ggff.net/media_outputs/0123456789abcdef0123456789abcdef.png\",\"request_id\":\"REQUEST_ID\",\"created_at\":1790980000}\n\ndata: [DONE]\n\n"
              }
            }
          },
          "400": {
            "description": "Unsupported or conflicting parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid customer API Key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Request exceeds upload limits.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity or rate limit exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Generation or image delivery failed; do not automatically resubmit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "507": {
            "description": "Insufficient capacity before submission.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageEditRequest"
              },
              "example": {
                "model": "gemini-3-pro-image",
                "prompt": "保持构图，将红色改为蓝色",
                "image": "https://example.com/reference.png",
                "stream": true,
                "partial_images": 0,
                "progress": true
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model",
                  "prompt"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "enum": [
                      "gemini-3.1-flash-lite-image",
                      "gemini-3.1-flash-image",
                      "gemini-3-pro-image",
                      "gpt-image-2.5-fast",
                      "gpt-image-2.5-pro",
                      "gpt-image-2",
                      "image-basic",
                      "image-fast",
                      "image-pro",
                      "image-creative"
                    ],
                    "description": "Public product route. Lite accepts 1K only."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "pattern": "\\S",
                    "description": "Non-blank prompt, at most 4096 Unicode characters."
                  },
                  "size": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "1024x1024",
                      "1536x1024",
                      "1024x1536",
                      "1792x1024",
                      "1024x1792",
                      "2048x2048",
                      "2048x1152",
                      "1152x2048",
                      "4096x4096",
                      "4096x2304",
                      "2304x4096"
                    ],
                    "description": "Target tier and aspect ratio; actual output pixels depend on the model. Must agree with resolution/aspect_ratio."
                  },
                  "resolution": {
                    "type": "string",
                    "pattern": "^(1[kK]|1080[pP]|2[kK]|4[kK])$",
                    "default": "1k",
                    "description": "Case-insensitive tier; Lite only accepts 1k/1080p."
                  },
                  "aspect_ratio": {
                    "type": "string",
                    "enum": [
                      "1:1",
                      "16:9",
                      "9:16",
                      "4:3",
                      "3:4",
                      "3:2",
                      "2:3",
                      "21:9"
                    ],
                    "default": "1:1"
                  },
                  "quality": {
                    "type": "string",
                    "enum": [
                      "auto",
                      "standard",
                      "hd"
                    ],
                    "description": "Fixed per model; standard for Lite/Flash/2.5-fast/basic/fast, hd for Pro/2.5-pro/2/pro/creative. auto accepts the fixed tier."
                  },
                  "n": {
                    "type": "integer",
                    "const": 1,
                    "default": 1
                  },
                  "response_format": {
                    "type": "string",
                    "enum": [
                      "url",
                      "b64_json"
                    ],
                    "default": "url",
                    "description": "Non-streaming response defaults to URL. Default SSE still embeds Base64, even when url is requested."
                  },
                  "enhance": {
                    "type": "boolean",
                    "default": true
                  },
                  "stream": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use true for SSE heartbeats followed by a completion event. No partial previews."
                  },
                  "partial_images": {
                    "type": "integer",
                    "const": 0
                  },
                  "delivery": {
                    "type": "string",
                    "const": "url",
                    "description": "Site extension: stream=true only, incompatible with response_format=b64_json. Emits image_url.completed."
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "One reference file. For multiple files use repeated image[]. At most 20 MiB per file."
                  },
                  "image[]": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "progress": {
                    "type": "string",
                    "enum": [
                      "true",
                      "false"
                    ],
                    "description": "Optional progress observation; true requires stream=true."
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "image"
                    ],
                    "not": {
                      "required": [
                        "image[]"
                      ]
                    }
                  },
                  {
                    "required": [
                      "image[]"
                    ],
                    "not": {
                      "required": [
                        "image"
                      ]
                    }
                  }
                ],
                "description": "Boolean form fields use true/false; n and partial_images are integer strings."
              }
            }
          }
        },
        "x-description-zh": "基于参考图编辑，不支持遮罩。JSON 使用 image；multipart 使用 image 或重复 image[] 文件字段，单文件最多 20 MiB。",
        "x-sse-events": [
          "#/components/schemas/ImageProgressEvent",
          "#/components/schemas/ImageCompletedEvent",
          "#/components/schemas/ImageURLCompletedEvent"
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Customer API Key from the console, not an administrator token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        }
      },
      "ImageGenerationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "prompt"
        ],
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "gemini-3.1-flash-lite-image",
              "gemini-3.1-flash-image",
              "gemini-3-pro-image",
              "gpt-image-2.5-fast",
              "gpt-image-2.5-pro",
              "gpt-image-2",
              "image-basic",
              "image-fast",
              "image-pro",
              "image-creative"
            ],
            "description": "Public product route. Lite accepts 1K only.",
            "x-description-zh": "本站公开调用名称，具体能力与限制见指南。"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S",
            "description": "Non-blank prompt, at most 4096 Unicode characters.",
            "x-description-zh": "必填，不能为空白，最多 4096 个 Unicode 字符。"
          },
          "size": {
            "type": "string",
            "enum": [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536",
              "1792x1024",
              "1024x1792",
              "2048x2048",
              "2048x1152",
              "1152x2048",
              "4096x4096",
              "4096x2304",
              "2304x4096"
            ],
            "description": "Target tier and aspect ratio; actual output pixels depend on the model. Must agree with resolution/aspect_ratio.",
            "x-description-zh": "分辨率档位与比例预设，实际像素以返回文件为准；必须与 resolution/aspect_ratio 一致。"
          },
          "resolution": {
            "type": "string",
            "pattern": "^(1[kK]|1080[pP]|2[kK]|4[kK])$",
            "default": "1k",
            "description": "Case-insensitive tier; Lite only accepts 1k/1080p.",
            "x-description-zh": "分辨率档位大小写不敏感，默认 1K，Lite 仅支持 1K。"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "1:1",
