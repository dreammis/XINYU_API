              "4:3",
              "3:4",
              "3:2",
              "2:3",
              "21:9"
            ],
            "default": "1:1",
            "x-description-zh": "画面比例；图片默认 1:1，普通视频默认 16:9，short 固定 9:16。"
          },
          "quality": {
            "type": "string",
            "enum": [
              "auto",
              "standard",
              "hd"
            ],
            "description": "Fixed per model; standard for Lite/Flash/2.5-fast/basic/fast, hd for Pro/2.5-pro/2/pro/creative. auto accepts the fixed tier.",
            "x-description-zh": "质量随模型固定，只接受 auto 或该模型的 standard/hd，不支持 low/medium/high。"
          },
          "n": {
            "type": "integer",
            "const": 1,
            "default": 1,
            "x-description-zh": "每次仅生成一个产物。"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "url",
              "b64_json"
            ],
            "default": "url",
            "description": "Non-streaming response defaults to URL. Default SSE still embeds Base64, even when url is requested.",
            "x-description-zh": "普通 JSON 默认只返回 URL；默认 SSE 即使填写 url 也仍包含 Base64。"
          },
          "enhance": {
            "type": "boolean",
            "default": true,
            "x-description-zh": "提示词增强开关，默认 true。"
          },
          "stream": {
            "type": "boolean",
            "default": false,
            "description": "Use true for SSE heartbeats followed by a completion event. No partial previews.",
            "x-description-zh": "true 返回等待心跳和最终图片事件。"
          },
          "partial_images": {
            "type": "integer",
            "const": 0,
            "x-description-zh": "仅接受 0，暂不提供中途预览图。"
          },
          "delivery": {
            "type": "string",
            "const": "url",
            "description": "Site extension: stream=true only, incompatible with response_format=b64_json. Emits image_url.completed.",
            "x-description-zh": "本站 URL 交付扩展，仅与 stream:true 同用，不能同时请求 b64_json；完成事件为 image_url.completed。"
          },
          "image_url": {
            "type": "string",
            "pattern": "^(https?://|data:image/)",
            "description": "HTTP(S) image URL or Base64 image data URL.",
            "x-description-zh": "单张 HTTP(S) 图片 URL 或图片 Base64 data URL。"
          },
          "reference_images": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(https?://|data:image/)",
              "description": "HTTP(S) image URL or Base64 image data URL."
            },
            "x-description-zh": "非空参考图 URL / data URL 数组；与单图输入互斥。"
          },
          "progress": {
            "type": "boolean",
            "default": false,
            "description": "Site extension: progress events from the same original task. Requires stream=true. Missing source percentage is null."
          }
        },
        "allOf": [
          {
            "not": {
              "required": [
                "image_url",
                "reference_images"
              ]
            }
          },
          {
            "if": {
              "required": [
                "delivery"
              ]
            },
            "then": {
              "required": [
                "stream"
              ],
              "properties": {
                "stream": {
                  "const": true,
                  "type": "boolean"
                },
                "response_format": {
                  "const": "url",
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "const": "gemini-3.1-flash-lite-image",
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "resolution": {
                  "pattern": "^(1[kK]|1080[pP])$"
                },
                "size": {
                  "enum": [
                    "auto",
                    "1024x1024",
                    "1536x1024",
                    "1024x1536",
                    "1792x1024",
                    "1024x1792"
                  ],
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "model": {
                  "enum": [
                    "gemini-3-pro-image",
                    "gpt-image-2.5-pro",
                    "gpt-image-2",
                    "image-pro",
                    "image-creative"
                  ],
                  "type": "string"
                }
              }
            },
            "then": {
              "properties": {
                "quality": {
                  "enum": [
                    "auto",
                    "hd"
                  ],
                  "type": "string"
                }
              }
            },
            "else": {
              "properties": {
                "quality": {
                  "enum": [
                    "auto",
                    "standard"
                  ],
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "required": [
                "progress"
              ],
              "properties": {
                "progress": {
                  "const": true
                }
              }
            },
            "then": {
              "required": [
                "stream"
              ],
              "properties": {
                "stream": {
                  "const": true,
                  "type": "boolean"
                }
              }
            }
          }
        ]
      },
