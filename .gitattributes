# 快照哈希和生成结果按 LF 保存，避免 Windows checkout 改写换行后校验失败。
catalog/** text eol=lf
content/** text eol=lf
gitbook/** text eol=lf
sources.json text eol=lf

# MP3 是二进制，不能沿用快照/导出目录的文本换行转换。
*.mp3 -text

# 清单资产逐字节导入并校验哈希；JSON 目录也不能在 checkout 时改写。
catalog/*/assets/** -text
gitbook/assets/** -text
projects/*/newapi/*/public-assets/** -text
